# Copy to .env.local. Never commit a real key.
OPENAI_API_KEY=
IMAGE_PROVIDER=sdxl
EVALUATION_PROVIDER=local
IMAGE_MODEL=gpt-image-2
EVALUATION_MODEL=gpt-5.5
SDXL_API_URL=http://sdxl:8001
SDXL_API_TIMEOUT_SECONDS=600
SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
SDXL_STRENGTH=0.28
SDXL_GUIDANCE_SCALE=7.0
SDXL_STEPS=30
SDXL_MAX_EDGE=1024
SDXL_CPU_OFFLOAD=true
REDIS_URL=redis://redis:6379/0
ARTIFACT_ROOT=/data/jobs
ARCHIVE_ROOT=/archive
MAX_VARIANTS=4
MAX_GENERATION_ATTEMPTS=2
